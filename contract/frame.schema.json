{
  "$comment": "Apache-2.0 \u2014 Copyright 2026 Martin Fabbri. Yardstick Capture Contract v1 (yardstick-capture/1).",
  "$id": "https://github.com/martin-fabbri/yardstick/contract/frame.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "yardstick-capture/1"
    },
    "ground_plane_residual_m": {
      "minimum": 0,
      "type": "number"
    },
    "ground_plane_residual_p95_m": {
      "minimum": 0,
      "type": "number"
    },
    "loop_closure_gaps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "first_t_s": {
            "type": "number"
          },
          "gap_m": {
            "minimum": 0,
            "type": "number"
          },
          "last_t_s": {
            "type": "number"
          },
          "marker_id": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "marker_id",
          "first_t_s",
          "last_t_s",
          "gap_m"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "marker_0_normal_ok": {
      "type": "boolean"
    },
    "marker_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "marker_layout": {
      "additionalProperties": false,
      "properties": {
        "closed_loop_edge_rmse_m": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "cycle_count": {
          "minimum": 0,
          "type": "integer"
        },
        "markers_connected_ids": {
          "items": {
            "maximum": 7,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "markers_seen_ids": {
          "items": {
            "maximum": 7,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "max_edge_residual_m": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "open_loop_cycle_residual_m": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "pair_edges": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "dist_3d_measured_m": {
                "minimum": 0,
                "type": "number"
              },
              "dist_3d_solved_m": {
                "minimum": 0,
                "type": "number"
              },
              "dist_horiz_measured_m": {
                "minimum": 0,
                "type": "number"
              },
              "dz_measured_m": {
                "type": "number"
              },
              "marker_i": {
                "maximum": 7,
                "minimum": 0,
                "type": "integer"
              },
              "marker_j": {
                "maximum": 7,
                "minimum": 0,
                "type": "integer"
              },
              "rel_yaw_measured_rad": {
                "type": "number"
              },
              "residual_m": {
                "type": "number"
              },
              "sightings_count": {
                "minimum": 1,
                "type": "integer"
              },
              "sigma_dist_m": {
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "marker_i",
              "marker_j",
              "sightings_count",
              "dist_3d_measured_m",
              "dist_3d_solved_m",
              "dist_horiz_measured_m",
              "dz_measured_m",
              "rel_yaw_measured_rad",
              "residual_m",
              "sigma_dist_m"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "pair_graph_connected": {
          "type": "boolean"
        },
        "per_marker_warp_corrections": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "correction_norm_m": {
                "minimum": 0,
                "type": "number"
              },
              "correction_xyz_m": {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "marker_id": {
                "maximum": 7,
                "minimum": 0,
                "type": "integer"
              },
              "pass_index": {
                "minimum": 0,
                "type": "integer"
              },
              "raw_yard_xyz_m": {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              "saved_index": {
                "minimum": 0,
                "type": "integer"
              },
              "t_s": {
                "type": "number"
              },
              "target_yard_xyz_m": {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              }
            },
            "required": [
              "marker_id",
              "pass_index",
              "t_s",
              "saved_index",
              "raw_yard_xyz_m",
              "target_yard_xyz_m",
              "correction_xyz_m",
              "correction_norm_m"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "printed_scale_factor": {
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "printed_scale_se": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "scale_applied": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "solver_method": {
          "enum": [
            "one_frame_pair_graph_v1",
            "arkit_world_fallback_v1"
          ],
          "type": "string"
        },
        "trajectory_warp_applied": {
          "type": "boolean"
        },
        "trajectory_warp_method": {
          "enum": [
            "similarity_plus_piecewise_anchor_v1",
            "piecewise_anchor_v1",
            "none"
          ],
          "type": "string"
        },
        "unconnected_marker_ids": {
          "items": {
            "maximum": 7,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "vio_to_pair_scale_ratio": {
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "solver_method",
        "markers_seen_ids",
        "markers_connected_ids",
        "unconnected_marker_ids",
        "pair_graph_connected",
        "cycle_count",
        "pair_edges",
        "open_loop_cycle_residual_m",
        "closed_loop_edge_rmse_m",
        "max_edge_residual_m",
        "printed_scale_factor",
        "printed_scale_se",
        "scale_applied",
        "trajectory_warp_applied"
      ],
      "type": "object"
    },
    "markers_yard": {
      "description": "Optional fused 3D coordinates and normals of detected ArUco markers in the Yard Frame (metres).",
      "items": {
        "additionalProperties": false,
        "properties": {
          "connected_to_origin": {
            "type": "boolean"
          },
          "marker_id": {
            "maximum": 7,
            "minimum": 0,
            "type": "integer"
          },
          "normal_xyz": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "pair_degree": {
            "minimum": 0,
            "type": "integer"
          },
          "placement_source": {
            "enum": [
              "pair_graph",
              "vio_similarity_fallback",
              "arkit_world_fallback"
            ],
            "type": "string"
          },
          "position_uncertainty_m": {
            "minimum": 0,
            "type": "number"
          },
          "sightings_count": {
            "minimum": 1,
            "type": "integer"
          },
          "xyz_arkit_open_loop_m": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "xyz_m": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "yaw_yard_rad": {
            "type": "number"
          }
        },
        "required": [
          "marker_id",
          "xyz_m",
          "normal_xyz",
          "sightings_count"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "method": {
      "enum": [
        "marker",
        "first_pose"
      ],
      "type": "string"
    },
    "north_calibration": {
      "additionalProperties": false,
      "properties": {
        "north_angle_deg": {
          "type": [
            "number",
            "null"
          ]
        },
        "north_uncertainty_deg": {
          "type": [
            "number",
            "null"
          ]
        },
        "sample_count": {
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "enum": [
            "ok",
            "denied",
            "accuracy_exceeded",
            "insufficient_samples"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "north_angle_deg",
        "north_uncertainty_deg",
        "sample_count"
      ],
      "type": "object"
    },
    "origin_height_m": {
      "type": "number"
    },
    "origin_residual_m": {
      "type": [
        "number",
        "null"
      ]
    },
    "pose_convention": {
      "const": "yard_right_handed_z_up"
    },
    "pose_jump_window_t_s": {
      "description": "YS-32: only pose jumps with t_s in [first Marker 0 sighting, loop_closed] count toward the loop gap; null = open end. Absent = every jump counts.",
      "items": {
        "type": [
          "number",
          "null"
        ]
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "pose_jumps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "jump_m": {
            "minimum": 0,
            "type": "number"
          },
          "saved_index_from": {
            "minimum": 0,
            "type": "integer"
          },
          "saved_index_to": {
            "minimum": 0,
            "type": "integer"
          },
          "t_s": {
            "type": "number"
          }
        },
        "required": [
          "saved_index_from",
          "saved_index_to",
          "t_s",
          "jump_m"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "world_to_yard_transform": {
      "items": {
        "type": "number"
      },
      "maxItems": 16,
      "minItems": 16,
      "type": "array"
    }
  },
  "required": [
    "contract",
    "method",
    "marker_id",
    "marker_0_normal_ok",
    "pose_convention",
    "world_to_yard_transform",
    "origin_height_m",
    "origin_residual_m",
    "ground_plane_residual_m",
    "ground_plane_residual_p95_m",
    "north_calibration",
    "loop_closure_gaps",
    "pose_jumps"
  ],
  "title": "Yardstick Level 2 Yard Frame Transform & Residuals",
  "type": "object"
}
